# ─── Nexus CV .gitignore ───
# Professional .gitignore for hackathon-ready repository

# ── Environment & Secrets ──
.env
.env.*
!.env.example
.venv/
venv/
env/

# ── Python ──
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.egg-info/
*.egg
dist/
build/
instance/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# ── Database (runtime-generated) ──
*.db
*.sqlite3

# ── Runtime Directories ──
logs/*.log
cache/bulk_results/*.json
output/*.csv
output/*.json
reports/*.pdf

# ── Uploads (user-generated, runtime) ──
uploads/*
!uploads/.gitkeep
!uploads/candidate_*.pdf

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── Node (if applicable) ──
node_modules/

# ── Temporary Files ──
*.tmp
*.bak
*.log
temp/

# ── Keep placeholder files ──
!output/.gitkeep
!cache/bulk_results/.gitkeep
!reports/.gitkeep
!logs/.gitkeep
